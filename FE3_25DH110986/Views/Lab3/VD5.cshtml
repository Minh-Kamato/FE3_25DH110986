@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD5</title>
    <script language="Javascript">
        function Respond() {
            var check = document.getElementsByName("checkbox");
            if (check[0].checked == true)
                document.getElementById("huflit").innerHTML = "Tôi là sinh viên khoa CNTT của trường HUFLIT";
            if (check[1].checked == true)
                document.getElementById("huflit").innerHTML = "Tôi không phải sinh viên khoa CNTT của trường HUFLIT";
        };
    </script>
</head>
<body>
    <h4>Bạn có phải sinh viên khoa CNTT của trường HUFLIT không?</h4>
    <input type="radio" name="checkbox" id="chon" value="" />Phải
    <br />
    <input type="radio" name="checkbox" id="chon" value="" />Không
    <br />
    <input type="submit" value="Câu trả lời" onclick="Respond(); " />
    <br />
    <span id="huflit"></span>
    <div>

    </div>
</body>
</html>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD6</title>
    <script language="Javascript">
        function ResultView() {
            var checkbox = document.getElementsByName("chon");
            var result = "";
            for (var i = 0; i < checkbox.length; i++) {
                if (checkbox[i].checked === true) {
                    result += " [" + checkbox[i].value + "] ";
                }
            }
            alert("Sở thích của bạn là: " + result);
        };
    </script>
</head>
<body>
    <h2>Hãy chọn các sở thích của bạn</h2>
    <input type="checkbox" name="chon" value="Đi chơi" /> <label>Đi chơi</label> <br />
    <input type="checkbox" name="chon" value="Đi du lịch" /> <label>Đi du lịch</label> <br />
    <input type="checkbox" name="chon" value="Đi ăn" /> <label>Đi ăn</label> <br />
    <input type="checkbox" name="chon" value="Đi siêu thị" /> <label>Đi siêu thị</label> <br />
    <input type="checkbox" name="chon" value="Học lập trình" /> <label>Học lập trình</label> <br />
    <input type="checkbox" name="chon" value="Ở nhà nghỉ ngơi" /> <label>Ở nhà nghỉ ngơi</label> <br />
    <input type="checkbox" name="chon" value="Đi xem phim" /> <label>Đi xem phim rạp</label> <br />
    <input type="checkbox" name="chon" value="Chơi game" /> <label>Chơi game</label> <br />
    <input type="checkbox" name="chon" value="Đi cafe" /> <label>Đi cafe</label> <br />
    <br /><br />
    <input type="button" id="btn" value="Kết thúc" onclick="ResultView()"; />
</body>
</html>
